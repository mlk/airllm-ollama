# Copy to .env and adjust as needed. All settings use the AIRLLM_OLLAMA_ prefix.
#
# A commented out line that shows a value other than the default of the setting
# has to end with "# alternative" - the test suite checks the documented
# defaults against the settings.

# Name of the service (the title of the OpenAPI schema). Defaults to
# "airllm-ollama" - uncomment to name the service differently.
# AIRLLM_OLLAMA_APP_NAME=airllm-ollama
AIRLLM_OLLAMA_HOST=127.0.0.1
# The port of the service. Ollama's own port is 11434 - use it only if no
# other Ollama is running.
AIRLLM_OLLAMA_PORT=8000
AIRLLM_OLLAMA_LOG_LEVEL=INFO

# Name of the single AirLLM model served by this instance.
# Smallest download first: 4.1 MB of random weights, good enough for smoke tests.
AIRLLM_OLLAMA_MODEL_NAME=hf-internal-testing/tiny-random-LlamaForCausalLM
# Smallest trained option: 269 MB of weights.
# AIRLLM_OLLAMA_MODEL_NAME=HuggingFaceTB/SmolLM2-135M-Instruct  # alternative

# Local checkpoint directory. When set, nothing is downloaded from Hugging Face
# (AirLLM splits the local weights into per-layer shards instead).
# AIRLLM_OLLAMA_MODEL_PATH=./models/tiny-random-llama  # alternative

# Device passed to AirLLM (ignored by the MLX backend on macOS).
AIRLLM_OLLAMA_DEVICE=cuda:0

# Maximum context length used by AirLLM.
AIRLLM_OLLAMA_MAX_SEQ_LEN=512

# Where AirLLM stores the per-layer shards it splits the checkpoint into.
# Empty means "next to the checkpoint".
# AIRLLM_OLLAMA_LAYER_SHARDS_SAVING_PATH=./models/shards  # alternative

# Default lifetime of the loaded model, e.g. "5m". Empty keeps it in memory
# until the process ends.
# AIRLLM_OLLAMA_KEEP_ALIVE=5m  # alternative

# Framing of the streaming responses: "ndjson" (like Ollama) or "sse".
# AIRLLM_OLLAMA_STREAM_FORMAT=ndjson

# The prompt template of the decision models. The placeholders are the state
# the question is about and the candidates the model chooses from.
# AIRLLM_OLLAMA_DECISION_TEMPLATE=Context: {state}\nChoices: {choices}\nSelected Option:

# The capabilities of the served model, comma separated. "completion" for a
# model that generates text, "decision" for a decision model (the one of
# POST /v1/systemone).
AIRLLM_OLLAMA_CAPABILITIES=completion
