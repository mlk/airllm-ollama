# Copy to .env and adjust as needed. All settings use the AIRLLM_OLLAMA_ prefix.

AIRLLM_OLLAMA_APP_NAME=airllm-ollama-proxy
AIRLLM_OLLAMA_HOST=127.0.0.1
AIRLLM_OLLAMA_PORT=11434
AIRLLM_OLLAMA_LOG_LEVEL=INFO

# Name of the single AirLLM model served by this instance.
AIRLLM_OLLAMA_MODEL_NAME=airllm-model
# Filesystem path to the model weights/artefacts used by AirLLM.
AIRLLM_OLLAMA_MODEL_PATH=
